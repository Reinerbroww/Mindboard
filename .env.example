NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Primary model (matches the current default; keep this value in mind)
GEMINI_MODEL=gemini-3.6-flash
# Optional fallback models tried in order when the primary model is busy
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest
